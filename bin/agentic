#!/usr/bin/env php8.4
<?php

declare(strict_types=1);

use App\Kernel;
use Gplanchat\AgenticBundle\Console\AgenticApplication;
use Symfony\Component\Dotenv\Dotenv;

require dirname(__DIR__).'/vendor/autoload.php';

// .env, then .env.local and .env.$APP_ENV.local: secrets stay out of the repository.
(new Dotenv())->bootEnv(dirname(__DIR__).'/.env');

// The project is where the agent is launched from — not this installation. Read at runtime: the
// container is compiled once and serves every directory.
if (!isset($_SERVER['AGENTIC_WORKSPACE'])) {
    $_SERVER['AGENTIC_WORKSPACE'] = $_ENV['AGENTIC_WORKSPACE'] = getcwd() ?: dirname(__DIR__);
}

// The bundle's TUI application, served by the host application container.
$kernel = new Kernel($_SERVER['APP_ENV'] ?? 'dev', (bool) ($_SERVER['APP_DEBUG'] ?? true));
$kernel->boot();
$kernel->getContainer()->get(AgenticApplication::class)->run();
