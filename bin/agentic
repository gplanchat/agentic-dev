#!/usr/bin/env php8.4
<?php

declare(strict_types=1);

use App\Kernel;
use Gplanchat\AgenticBundle\Console\AgenticApplication;
use Symfony\Component\Dotenv\Dotenv;

require dirname(__DIR__).'/vendor/autoload.php';

// .env, puis .env.local et .env.$APP_ENV.local : les secrets restent hors du dépôt.
(new Dotenv())->bootEnv(dirname(__DIR__).'/.env');

// L'application TUI du bundle, servie par le conteneur de l'application hôte.
$kernel = new Kernel($_SERVER['APP_ENV'] ?? 'dev', (bool) ($_SERVER['APP_DEBUG'] ?? true));
$kernel->boot();
$kernel->getContainer()->get(AgenticApplication::class)->run();
