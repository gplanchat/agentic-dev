{
    "name": "gplanchat/agentic",
    "description": "Durable AI agents on Symfony AI: tool guard, human questions, watches, context budget and delegation.",
    "keywords": [
        "ai",
        "agent",
        "llm",
        "durable-execution",
        "symfony-ai",
        "tool-calling"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ],
    "support": {
        "issues": "https://github.com/gplanchat/agentic-dev/issues",
        "source": "https://github.com/gplanchat/agentic"
    },
    "require": {
        "php": ">=8.2",
        "gplanchat/durable": "0.1.x-dev",
        "symfony/ai-agent": "0.13.*",
        "symfony/ai-platform": "0.13.*",
        "symfony/ai-mistral-platform": "0.13.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2"
    },
    "autoload": {
        "psr-4": {
            "Gplanchat\\Agentic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gplanchat\\Agentic\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
