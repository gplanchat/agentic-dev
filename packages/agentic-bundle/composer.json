{
    "name": "gplanchat/agentic-bundle",
    "description": "Symfony integration of gplanchat/agentic: the agentic TUI application and its web version.",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "ai",
        "agent",
        "tui",
        "durable-execution"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ],
    "support": {
        "issues": "https://github.com/gplanchat/agentic-dev/issues",
        "source": "https://github.com/gplanchat/agentic-bundle"
    },
    "require": {
        "php": ">=8.4.1",
        "gplanchat/agentic": "self.version",
        "gplanchat/durable-bundle": "0.1.x-dev",
        "symfony/config": "8.2.*",
        "symfony/console": "8.2.*",
        "symfony/dependency-injection": "8.2.*",
        "symfony/http-foundation": "8.2.*",
        "symfony/http-kernel": "8.2.*",
        "symfony/routing": "8.2.*",
        "symfony/tui": "8.2.*",
        "symfony/messenger": "8.2.*",
        "symfony/uid": "8.2.*",
        "symfony/http-client": "8.2.*",
        "league/commonmark": "^2.10",
        "tempest/highlight": "^2.28",
        "amphp/http-client": "^5.3",
        "mcp/sdk": "^0.8",
        "nyholm/psr7": "^1.8",
        "symfony/yaml": "8.2.*",
        "internal/toml": "^1.1",
        "symfony/process": "8.2.*",
        "sebastian/diff": "^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "symfony/framework-bundle": "8.2.*",
        "phpstan/phpstan": "^2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../agentic{,}"
        }
    ],
    "autoload": {
        "psr-4": {
            "Gplanchat\\AgenticBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gplanchat\\AgenticBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.25"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
