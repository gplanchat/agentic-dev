{
    "name": "gplanchat/agentic-dev",
    "description": "Monorepo root: gplanchat/agentic + gplanchat/agentic-bundle, and the dev application that runs them.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {"type": "path", "url": "packages/agentic"},
        {"type": "path", "url": "packages/agentic-bundle"}
    ],
    "require": {
        "php": ">=8.4.1",
        "gplanchat/agentic": "0.1.x-dev",
        "gplanchat/agentic-bundle": "0.1.x-dev",
        "symfony/dotenv": "8.2.*",
        "symfony/framework-bundle": "8.2.*"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "config": {
        "allow-plugins": {"symfony/flex": false},
        "platform": {"php": "8.4.25"},
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
